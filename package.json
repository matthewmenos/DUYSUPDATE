{
  "name": "duys",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm --workspace backend run dev & npm --workspace frontend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace backend run dev",
    "build": "npm --workspace backend run build & npm --workspace frontend run build",
    "build:frontend": "npm --workspace frontend run build",
    "start": "npm --workspace backend run start",
    "preview": "npm --workspace frontend run preview",
    "lint": "npm --workspace frontend run lint"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.18.0",
    "axios": "^1.6.2",
    "zustand": "^4.4.2",
    "react-query": "^3.39.3",
    "@tanstack/react-query": "^5.0.0",
    "date-fns": "^2.30.0",
    "clsx": "^2.0.0",
    "react-icons": "^4.12.0",
    "web3": "^4.1.1",
    "ethers": "^6.10.0",
    "react-hot-toast": "^2.4.1",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.0",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.32",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.53.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
