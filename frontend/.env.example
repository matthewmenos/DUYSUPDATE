# Frontend env (single-project Vercel deploy: VITE_API_URL stays empty = same-origin /api)
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
# Base URL for HLS playback of live streams (e.g. your Mux/Cloudflare Stream domain, no trailing slash)
VITE_HLS_BASE_URL=
