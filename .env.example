# Frontend / Vercel
# Leave VITE_API_URL EMPTY for the single-project Vercel deployment — the
# frontend then calls the backend same-origin at /api (see vercel.json).
# For local dev it is also empty: the Vite dev proxy maps /api -> :5000.
# Only set it if you host the backend on a separate domain.
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Backend / local development
DATABASE_URL=postgresql://user:password@localhost:5432/duys_db
AUTO_MIGRATE=true
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=30d
JWT_REFRESH_EXPIRE=90d
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# Referral links use this frontend origin (falls back to APP_URL, then https://duys.app)
FRONTEND_URL=http://localhost:3000
# Live streaming — RTMP ingest URL (used for live-room publish keys)
RTMP_URL=rtmp://localhost:1935/live
# HypeLab rewarded-ad webhook
HYPELAB_WEBHOOK_SECRET=your-hypelab-webhook-secret
HYPELAB_REWARD_POINTS=10
# DUYS token contract (Web3)
DUYS_CONTRACT_ADDRESS=0xYourDuysTokenContract
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
VAULT_WALLET_ADDRESS=0xYourVaultWallet
# Cloudflare R2
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ACCOUNT_ID=your-r2-account-id
R2_ENDPOINT=https://your-r2-account-id.r2.cloudflarestorage.com
R2_BUCKET_PUBLIC=duys-media-public
R2_BUCKET_PUBLIC_URL=https://your-custom-domain.com
R2_BUCKET_VERIFICATION=duys-verification-private
WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
WEB3_NETWORK=ethereum
WEB3_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-key
FACE_VERIFY_API_URL=http://localhost:8000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
REDIS_URL=redis://localhost:6379
ADMIN_EMAIL=admin@duys.app
ADMIN_PASSWORD=change-me-in-production
ENABLE_2FA=true
ENABLE_FACE_VERIFY=true
ENABLE_WEB3=true
